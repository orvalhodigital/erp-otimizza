# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA ERP COMERCIAL E FINANCEIRO
# ==============================================================================

# Servidor e Aplicação
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. OPÇÃO LOCAL: PostgreSQL Local ou Docker
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_erp_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sistema_erp_test

# ------------------------------------------------------------------------------
# 2. OPÇÃO SUPABASE + VERCEL (Produção ou Desenvolvimento em Nuvem)
# ------------------------------------------------------------------------------
# DATABASE_URL (Pooler / Supavisor - Porta 6543 - Transaction Mode):
# Recomendado para a Vercel Serverless. Permite milhares de conexões simultâneas sem esgotar o PostgreSQL.
# Exemplo:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# DIRECT_URL (Conexão Direta - Porta 5432 - Session Mode):
# Utilizada estritamente para executar scripts de migração (npm run db:migrate).
# Exemplo:
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E SESSÃO
# ------------------------------------------------------------------------------
# Chave aleatória com no mínimo 32 caracteres para assinatura de cookies e sessões
SESSION_SECRET=substitua_por_uma_chave_segura_de_no_minimo_32_caracteres_aleatorios
